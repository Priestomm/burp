# Copy to .env (git-ignored) and fill in. Never commit real values.

# Anthropic API key, used to structure recipes and to read video frames.
ANTHROPIC_API_KEY=
# Model used by the pipeline (optional).
BURP_MODEL=claude-opus-5-5

# Telegram bot (bot.py). Comma-separated numeric user ids allowed to use it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Local audio transcription (faster-whisper): tiny, base, small...
WHISPER_MODEL=base
# Optional Netscape cookies file for Instagram links that require a login.
INSTAGRAM_COOKIES_FILE=

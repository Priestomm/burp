# Copy to .env (git-ignored) and fill in. Never commit real values.

# Anthropic API key, used to structure recipes and to read video frames.
ANTHROPIC_API_KEY=
# Model used for structuring and frame analysis (optional).
BURP_MODEL=claude-sonnet-5-5
# Cheaper model for small jobs: splitting titles, picking the best video frame (optional).
BURP_FAST_MODEL=claude-haiku-5-5

# Where the recipe library (SQLite) lives (optional, default data/burp.db).
BURP_DB_PATH=
# Where dish photos are kept (optional, default data/media).
BURP_MEDIA_DIR=
# Take the dish photo from the reel downloaded with the link (off by default). Personal use
# only: it extends a download Instagram's terms forbid, and the frame is the creator's image.
BURP_PHOTO_FROM_REEL=false

# Telegram bot (`burp bot`). Comma-separated numeric user ids allowed to use it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Local audio transcription (faster-whisper): tiny, base, small...
WHISPER_MODEL=base
# Optional Netscape cookies file for Instagram links that require a login.
INSTAGRAM_COOKIES_FILE=

# Zine theme: pictures of fresh ingredients from Pexels (free key at pexels.com/api).
PEXELS_API_KEY=
# Contact sent in the User-Agent to Open Food Facts, as they ask apps to do.
BURP_CONTACT_EMAIL=
# rembg model for cut-outs (optional): silueta, u2netp, isnet-general-use...
BURP_CUTOUT_MODEL=silueta

          },
          "servings_estimated": {
            "type": "boolean",
            "title": "Servings Estimated"
          },
          "time_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Minutes"
          },
          "time_estimated": {
            "type": "boolean",
            "title": "Time Estimated"
          },
          "tags": {
            "$ref": "#/components/schemas/Tags"

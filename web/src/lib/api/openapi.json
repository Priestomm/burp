        "required": [
          "id",
          "created_at",
          "title",
          "nome_riga_1",
          "nome_riga_2",
          "descrittore",
          "source_url",
          "author_handle",
          "servings",
          "servings_estimated",
          "time_minutes",
          "time_estimated",
          "tags",
          "ingredients",
          "steps",
          "original_steps",
          "steps_rewritten",
          "steps_note",
          "filled_by",
          "still_missing",
          "completeness",
          "content_source",
          "cooked",
          "photo",
          "photo_pending"

            "$ref": "#/components/schemas/CookedOut"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "photo_pending": {
            "type": "boolean",

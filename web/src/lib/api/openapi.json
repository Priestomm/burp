            "type": "array",
            "title": "Ingredients"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps",
            "description": "Rewritten by the AI when filled, else as in the post"
          },
          "original_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Original Steps",
            "description": "As in the post"
          },
          "steps_rewritten": {
            "type": "boolean",
            "title": "Steps Rewritten"
          },
          "steps_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps Note",
            "description": "What the AI added to the steps"
          },
          "filled_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }

          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "nome_riga_1": {
            "type": "string",
            "title": "Nome Riga 1"
          },
          "nome_riga_2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nome Riga 2"
          },
          "diet": {
            "type": "string",
            "enum": [
              "vegan",
              "vegetarian",
              "neither"
            ],
            "title": "Diet"
          },
          "course": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "antipasto",
                  "primo",
                  "secondo",
                  "contorno",
                  "piatto unico",
                  "dolce",
                  "colazione",
                  "snack",
                  "bevanda",
                  "salsa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Course"
          },
          "cuisine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cuisine"
          },
          "to_clarify": {
            "type": "integer",
            "title": "To Clarify",
            "description": "Quantities still unknown, plus 1 if there are no steps"
          },
          "cooked": {
            "$ref": "#/components/schemas/CookedOut"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "nome_riga_1",
          "nome_riga_2",
          "diet",
          "course",
          "cuisine",
          "to_clarify",
          "cooked"
        ],
        "title": "LibraryItem"
      },
      "PhotoOut": {
        "properties": {
          "src": {
            "type": "string",
            "title": "Src",
            "description": "The halftone print, path under /api/media"
          },
          "original_src": {
            "type": "string",
            "title": "Original Src"
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "frame (from a video you sent) or screenshot"
          },
          "creator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Creator"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "src",
          "original_src",
          "alt",
          "source",
          "creator",
          "source_url"
        ],
        "title": "PhotoOut"
      },
      "QuantityIn": {
        "properties": {
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "type": "object",
        "required": [
          "quantity"
        ],
        "title": "QuantityIn"
      },
      "RecipeDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },

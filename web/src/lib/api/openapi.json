      "Tags": {
        "properties": {
          "cuisine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cuisine",
            "description": "In italiano, es. italiana, indiana"
          },
          "course": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "antipasto",
                  "primo",
                  "secondo",
                  "contorno",
                  "piatto unico",
                  "dolce",
                  "colazione",
                  "snack",
                  "bevanda",
                  "salsa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Course"
          },
          "diet": {
            "type": "string",
            "enum": [
              "vegan",
              "vegetarian",
              "neither"
            ],
            "title": "Diet"
